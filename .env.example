# shawty environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Postgres (async driver, used by the app) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME

# --- Postgres (sync driver, used by Alembic) ---
SYNC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME

# --- Supabase (JWT issuer / JWKS) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# --- Redis (cache + rate limiter) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Kafka (analytics pipeline) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- ClickHouse (analytics reads) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# --- Runtime ---
# LOG_LEVEL=INFO        # DEBUG / INFO / WARNING / ERROR
# LOG_JSON=false        # set to true for structured JSON output
